entrypoint = "app.py"
modules = ["python-3.11"]
run = "python run_replit.py"

[nix]
channel = "stable-24_05"

[deployment]
build = "pip install -r requirements.txt"
run = ["python", "run_replit.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80

[packager]
language = "python3"

[packager.features]
packageSearch = true
guessImports = true
